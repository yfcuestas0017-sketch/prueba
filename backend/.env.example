# --- Producción (Render) ---
# Cadena de conexión que te da Neon (Dashboard > Connection Details > "Pooled connection")
DATABASE_URL=postgresql://usuario:password@ep-xxxxx.neon.tech/BaseDatosGrado?sslmode=require

# URL pública de tu frontend en Vercel (para permitir CORS). Admite varias
# separadas por coma, por ejemplo dominio de preview + dominio de producción.
FRONTEND_URL=https://tu-proyecto.vercel.app

# Puerto (Render lo asigna automáticamente, no hace falta tocarlo)
PORT=5000

# Secreto para firmar los tokens de sesión (JWT). Debe tener mínimo 32
# caracteres. Genera uno con:
# node -e "console.log(require('crypto').randomBytes(48).toString('hex'))"
JWT_SECRET=
JWT_EXPIRES_IN=8h

# --- Desarrollo local (si no usas DATABASE_URL) ---
# PGHOST=localhost
# PGUSER=postgres
# PGPASSWORD=tu_password
# PGDATABASE=BaseDatosGrado
# PGPORT=5432
